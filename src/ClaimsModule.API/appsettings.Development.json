{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ClaimsDatabase": "Server=(localdb)\\mssqllocaldb;Database=ClaimsModule;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "ClaimsModule",
    "Audience": "ClaimsModule.Client",
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef",
    "ExpiryMinutes": 480
  },
  "Storage": {
    "Provider": "LocalFileSystem",
    "LocalFileSystemRootPath": "App_Data/claim-documents",
    "LocalFileSystemPublicBaseUrl": "/api/claims/local-documents",
    "LocalFileSystemSigningSecret": "local-dev-only-signing-secret-change-me"
  }
}
